# RestoOS - Environment Variables
# Copy this file to .env.local or .env and fill in the values

# Database (required)
DATABASE_URL=

# Better Auth (required — generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=

# Better Auth - Trust This Proxy (set to 1 in production behind reverse proxy)
BETTER_AUTH_TRUST_PROXY=1

# App URL (required — used for auth callbacks, email links, SEO metadata)
NEXT_PUBLIC_APP_URL=

# Supabase (required for database connection)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Demo (optional — set to "true" in production to enable demo login)
ALLOW_DEMO=
