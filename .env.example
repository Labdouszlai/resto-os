# RestoOS - Environment Variables
# Copy this file to .env.local or .env and fill in the values

# Database (Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-here

# Better Auth - Trust This Proxy (1 in production behind reverse proxy)
BETTER_AUTH_TRUST_PROXY=1

# App URL (used for auth callbacks, email links, SEO metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for auth provider & database)
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
